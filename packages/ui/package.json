{
  "name": "@loupe/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Loupe's primitives, tokens and surface: the design system the toolbar is drawn with. Bundled into @danarocha/loupe's dist, never published (ADR 0010).",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./announcer": "./src/announcer/announcer.tsx",
    "./surface": "./src/surface/index.tsx",
    "./tokens": "./src/tokens.ts",
    "./testing": "./src/surface/render.fixture.tsx",
    "./listen": "./src/announcer/announcer.fixture.ts",
    "./jsdom-gaps": "./src/surface/jsdom-gaps.fixture.ts",
    "./workbench": "./workbench/shell/index.tsx",
    "./workbench/vite": "./workbench/vite.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite --config workbench/vite.config.ts",
    "build": "rm -rf dist && tsc6 -p tsconfig.build.json && vite build && vitest run src/build.test.ts",
    "test": "vitest run --exclude src/build.test.ts",
    "typecheck": "tsc6 --noEmit"
  },
  "dependencies": {
    "@ui-sdk/core": "0.1.0-beta.14",
    "@ui-sdk/react": "0.1.0-beta.14"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@rolldown/plugin-babel": "0.3.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^22.19.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.2.1",
    "axe-core": "4.14.1",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "26.1.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.8",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  }
}
