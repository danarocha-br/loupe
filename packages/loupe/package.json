{
  "name": "@danarocha/loupe",
  "version": "0.0.6",
  "description": "Inspect and override the props of real components in a running Next.js app.",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    "./mount": {
      "types": "./dist/mount.d.ts",
      "default": "./dist/mount.js"
    },
    "./next": {
      "types": "./dist/next.d.cts",
      "default": "./dist/next.cjs"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./proposal.schema.json": "./proposal.schema.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "loupe": "dist/bin.js"
  },
  "files": [
    "dist",
    "proposal.schema.json"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danarocha-br/loupe.git",
    "directory": "packages/loupe"
  },
  "scripts": {
    "build": "pnpm --dir ../patterns build && rm -rf dist && tsc6 -p tsconfig.build.json && vite build && vitest run src/build.test.ts",
    "watch": "node --experimental-strip-types --disable-warning=ExperimentalWarning watch.ts",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc6 --noEmit"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@rolldown/plugin-babel": "0.3.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^22.19.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "axe-core": "4.14.1",
    "babel-plugin-react-compiler": "1.0.0",
    "flags": "4.2.4",
    "jsdom": "26.1.0",
    "next": "16.3.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "vite": "8.3.8",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@babel/parser": "^7.29.13",
    "@ui-sdk/core": "0.1.0-beta.14",
    "@ui-sdk/react": "0.1.0-beta.14",
    "jsonc-parser": "3.3.1",
    "magic-string": "^0.30.21",
    "react-docgen-typescript": "2.4.0",
    "ts-morph": "28.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "peerDependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  }
}
